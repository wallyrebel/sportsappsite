<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Broadcast source status</title></head><body>
<main><a href="/broadcast">← Open broadcast</a><h1>Broadcast source status</h1><p>Read-only operations dashboard. A successful fetch is not a guarantee that every school has reported. Score conflicts are withheld from the broadcast.</p><p id="summary">Connecting…</p><h2>Source health</h2><div id="sources"></div><h2>Conflicts held for review</h2><div id="conflicts"></div><h2>Known coverage gaps</h2><div id="gaps"></div><h2>Email and sponsors</h2><p>Email alerts require a recipient and a mail API secret. Sponsor inventory is managed in <code>public/broadcast-sponsors.json</code>; no paid placements are active by default.</p></main>
<script>
  import type {BroadcastData} from '../../broadcast/model';
  const root=(id:string)=>document.getElementById(id)!;
  function entry(title:string,detail:string,url?:string){const a=document.createElement('article'),h=document.createElement('h3'),p=document.createElement('p');h.textContent=title;p.textContent=detail;a.append(h,p);if(url&&url.startsWith('https://')){const link=document.createElement('a');link.href=url;link.textContent='View source';link.target='_blank';link.rel='noopener';a.append(link);}return a;}
  async function refresh(){try{const r=await fetch('/api/broadcast',{cache:'no-store',signal:AbortSignal.timeout(20000)});if(!r.ok)throw new Error('Data service unavailable');const d:BroadcastData=await r.json();root('summary').textContent=`Updated ${new Date(d.generatedAt).toLocaleString()} · ${d.games.filter(g=>g.status==='final'&&!g.conflict).length} reported finals · ${d.games.filter(g=>g.status==='scheduled'&&!g.conflict).length} scheduled events`;
  root('sources').replaceChildren(...d.sources.map(s=>entry(`${s.state.toUpperCase()} · ${s.name}`,`${s.count} retained records · Last success: ${s.lastSuccess?new Date(s.lastSuccess).toLocaleString():'Never'} · ${s.failures} consecutive failures${s.error?' · '+s.error:''}\n${s.note}`,s.url)));
  root('gaps').replaceChildren(...d.gaps.map(s=>entry(s.name,s.note,s.url)));root('conflicts').replaceChildren(...d.conflicts.map(g=>entry(`${g.date} · ${g.teams.join(' / ')}`,`${g.source} · ${g.scores?.join('–')||g.status}`,g.sourceUrl)));if(!d.conflicts.length)root('conflicts').textContent='No detected conflicts. Matching currently uses normalized team names and explicit aliases.';
  }catch{root('summary').textContent='Data service unavailable. Retaining the previous view; it may be stale.';}}
  void refresh();setInterval(()=>void refresh(),60000);
</script>
<style>body{font:16px/1.5 system-ui;background:#0b1728;color:#e7edf4;margin:0}main{max-width:1100px;padding:40px 24px;margin:auto}h1{font-size:38px}h2{margin-top:38px}a{color:#f4bd4c}#sources,#gaps{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:15px}article{padding:18px;background:#15263d;border:1px solid #344b67;border-radius:6px}h3{margin-top:0;font-size:17px}article p{white-space:pre-line;color:#bac9da;font-size:14px}code{color:#f4bd4c}</style>
</body></html>
