        <section id="scoreboard" hidden><div class="board-heading"><p>MISSISSIPPI SCOREBOARD</p><h1 id="board-title">Final scores</h1><span id="board-subtitle">Around Mississippi</span></div><div id="board-games"></div></section>
        <section id="rankings" hidden><div class="board-heading"><p>MISSISSIPPI POWER INDEX</p><h1 id="ranking-title"></h1><span id="ranking-subtitle"></span></div><div class="ranking-columns"><span>RANK</span><span>TEAM</span><span>RECORD</span><span>RATING</span></div><div id="ranking-rows"></div><div id="ranking-footer"></div></section>
        <div id="sponsor-full" hidden><span>COMMUNITY PARTNER</span><img id="full-image" alt=""/><div id="full-house" hidden><strong>Your ad here</strong><p>Reach Mississippi sports fans.</p><b id="full-phone">662-576-1554</b><small>CALL TO ADVERTISE</small></div><h1 id="full-name"></h1><p>MISSISSIPPI SPORTS GROUP</p></div>
        <div class="progress"><div id="progress-bar"></div></div>
      </section>
      <aside aria-label="Scores, upcoming games, and sponsors">
        <div class="rail-columns">
          <section class="rail-column" aria-label="Reported scores"><div class="rail-heading"><span class="dot"></span><h2 id="scores-title">SCORES</h2></div><div id="rail-scores"><p class="empty">Checking reported scores…</p></div></section>
