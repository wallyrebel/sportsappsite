        </div>
        <div class="sponsor"><span>COMMUNITY PARTNER</span><img id="sponsor-image" alt="" hidden/><div id="sponsor-house"><strong id="house-title">Your ad here</strong><small>Reach Mississippi sports fans.</small><b id="house-phone">662-576-1554</b><small>CALL TO ADVERTISE</small></div><div id="sponsor-name"></div></div>
      </aside>
    </section>
    <footer><div class="ticker-label" id="ticker-label">SCORES</div><div class="ticker-window"><div id="score-ticker">Mississippi Sports Group • Your state. Your teams.</div></div><div class="network-bug">MS<span>SPORTS</span></div></footer>
    <audio id="broadcast-audio" loop preload="none" aria-label="Broadcast background music"></audio>
  </main>
  <script>import '../../broadcast/client'; import '../../broadcast/audio';</script>
</body></html>
<style is:global>
  *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050d19;color:#f5f7fb;font-family:Arial,Helvetica,sans-serif}#channel{width:1920px;height:1080px;position:absolute;transform-origin:top left;background:#0b1728;overflow:hidden}header{height:132px;display:flex;align-items:center;padding:0 58px;border-bottom:1px solid #304159;background:#101f34;gap:50px}.brand{display:flex;align-items:center;gap:18px;font-weight:900;font-size:30px;letter-spacing:2px}.brand span:not(.mark){display:block;font-size:14px;letter-spacing:7px;margin-top:7px;color:#d3dae5}.mark{display:grid;place-items:center;width:77px;height:68px;background:#f4bd4c;color:#0b1728;font-size:37px;font-weight:1000;letter-spacing:-3px;transform:skew(-7deg)}.coverage{margin:auto;display:flex;align-items:center;gap:23px;font-size:18px;letter-spacing:3px;color:#c1cbda}.coverage i{width:4px;height:4px;background:#f4bd4c;border-radius:50%}.timeblock{text-align:right;min-width:225px}.timeblock strong{font-size:36px;font-variant-numeric:tabular-nums;display:block}.timeblock span{font-size:15px;letter-spacing:1px;color:#b7c5d7;display:block;margin-top:5px}.content{height:799px;display:grid;grid-template-columns:minmax(0,1fr) 700px;gap:26px;padding:28px 50px 20px}.stage{position:relative;overflow:hidden;border:1px solid #324357;background:#15253a}#story{height:100%;position:relative}#story-image{width:100%;height:100%;object-fit:cover;background:radial-gradient(ellipse at top right,#27466a,#101c30)}.shade{position:absolute;inset:0;background:linear-gradient(0deg,#081321 2%,#081321ed 14%,#08132120 75%)}.story-copy{position:absolute;bottom:44px;left:46px;right:46px}.eyebrow{display:flex;align-items:center;gap:24px;font-size:18px;letter-spacing:2px}.eyebrow span:first-child{background:#f4bd4c;color:#101a2a;padding:10px 14px;font-weight:800}#story-date{color:#dce4ef;letter-spacing:1px}h1{font-size:56px;line-height:1.09;letter-spacing:-1px;margin:22px 0;max-width:1170px;text-wrap:balance}.byline{display:flex;justify-content:space-between;color:#c5d2e1;letter-spacing:2px;font-size:15px}.byline span{letter-spacing:1px;color:#a5b5c8}.progress{position:absolute;bottom:0;width:100%;height:5px;background:#253a52}#progress-bar{height:100%;background:#f4bd4c;transform-origin:left;transform:scaleX(0)}aside{display:flex;flex-direction:column;min-width:0}.rail-columns{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;flex:1;min-height:0}.rail-column{min-width:0;overflow:hidden}.rail-heading h2{white-space:nowrap}#headline{font-size:50px}.rail-column .game-meta{font-size:12px}.rail-column .team{font-size:22px}.rail-column .empty{font-size:20px}.rail-heading{display:flex;align-items:center;gap:10px;border-bottom:2px solid #f4bd4c;padding:4px 0 14px}.rail-heading h2{font-size:20px;letter-spacing:2px;margin:0}.rail-heading>span:last-child{margin-left:auto;font-size:13px;color:#aebed1}.dot{width:8px;height:8px;border-radius:50%;background:#f4bd4c}#rail-games{flex:1;overflow:hidden}.game{padding:15px 0;border-bottom:1px solid #334357}.game-meta{color:#f4bd4c;font-size:13px;letter-spacing:.7px;margin-bottom:9px;text-transform:uppercase}.team{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:22px;font-weight:700;line-height:1.25;margin:5px 0}.team span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.team b{font-size:24px;min-width:35px;text-align:right}.game-foot{font-size:12px;color:#9fb0c5;margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{font-size:22px;line-height:1.5;color:#aebed1;padding:20px}.sponsor{height:350px;flex-shrink:0;border:1px solid #45566c;background:#14243b;margin-top:18px;text-align:center;padding:17px;position:relative}.sponsor>span{display:block;color:#aebed1;font-size:12px;letter-spacing:3px;margin-bottom:15px}.sponsor img{width:100%;height:260px;object-fit:contain}.sponsor strong{font-size:26px;line-height:1.15}.sponsor small{display:block;font-size:14px;margin:14px 0;color:#aebed1}.sponsor b{color:#f4bd4c;font-size:16px}#sponsor-name{font-size:14px;margin-top:5px}footer{display:flex;height:99px;align-items:center;background:#eff3f7;color:#112238;border-top:5px solid #f4bd4c}.ticker-label{background:#f4bd4c;height:100%;min-width:174px;display:grid;place-items:center;font-size:24px;font-weight:900;letter-spacing:1px}.ticker-window{flex:1;overflow:hidden;height:100%;display:flex;align-items:center}#score-ticker{font-size:27px;font-weight:700;white-space:nowrap;will-change:transform;display:inline-block}.ticker-item{display:inline-block;padding:0 45px;border-right:1px solid #acb7c6}.ticker-item small{font-size:16px;letter-spacing:.5px;color:#4e6179;margin-right:20px}.network-bug{height:100%;width:122px;background:#162840;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#f4bd4c;font-size:36px;font-weight:900;z-index:1}.network-bug span{font-size:11px;letter-spacing:3px;color:white}.newsline{height:50px;display:flex;align-items:center;background:#050d19;overflow:hidden;font-size:19px}.newsline>b{padding:0 27px;color:#f4bd4c;font-size:15px;letter-spacing:2px;z-index:1;background:#050d19;height:100%;display:flex;align-items:center}.news-window{overflow:hidden;flex:1}#news-ticker{white-space:nowrap;display:inline-block;will-change:transform}#scoreboard{height:100%;padding:34px 40px}.board-heading p{font-size:15px;letter-spacing:3px;color:#f4bd4c;margin:0}.board-heading h1{font-size:46px;margin:10px 0}.board-heading>span{color:#aebed1;font-size:16px}#board-games{display:grid;grid-template-columns:1fr 1fr;gap:16px 30px;margin-top:26px}#board-games .game{background:#1c2e46;padding:18px 23px;border:1px solid #354760;min-height:148px}#board-games .team{font-size:25px}#board-games .game-meta{font-size:14px}#sponsor-full{position:absolute;inset:0;background:radial-gradient(ellipse at center,#243d5c,#081323);z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px}#sponsor-full[hidden],[hidden]{display:none!important}#sponsor-full>span{font-size:22px;letter-spacing:6px;color:#f4bd4c}#sponsor-full img{width:100%;height:480px;min-height:0;object-fit:contain;margin:20px 0 0}#sponsor-full h1{font-size:30px;margin:12px 0}#sponsor-full p{letter-spacing:7px;color:#aebed1}
#sponsor-house{height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center}#sponsor-house strong{font-size:38px}#sponsor-house b{font-size:33px}#full-house{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:22px}#full-house strong{font-size:84px}#full-house p{font-size:28px;letter-spacing:1px;margin:0}#full-house b{font-size:80px;color:#f4bd4c}#full-house small{font-size:20px;letter-spacing:4px}#rankings{height:100%;padding:34px 40px}.ranking-columns,.ranking-row{display:grid;grid-template-columns:80px 1fr 130px 110px;gap:18px;align-items:center}.ranking-columns{margin-top:28px;font-size:14px;letter-spacing:2px;color:#aebed1}.ranking-row{margin-top:10px;padding:14px 18px;background:#1c2e46;border:1px solid #354760;min-height:78px;font-size:26px}.ranking-row>b{color:#f4bd4c}.ranking-row strong{font-size:26px}.ranking-row small{display:block;font-size:14px;color:#aebed1;margin-top:4px}#ranking-footer{position:absolute;bottom:24px;left:40px;font-size:15px;color:#aebed1}</style>
