{
  "name": "mississippi-scoreboard",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{"pattern":"mississippisportsapp.com/scoreboard/api/scores*","zone_name":"mississippisportsapp.com"}],
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true,"html_handling":"auto-trailing-slash"}
}
