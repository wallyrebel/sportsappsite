{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mississippi-watch-scoreboard",
  "main": "index.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "ASSETS", "service": "mississippi-sports-tv" }],
  "routes": [
    { "pattern": "watch.mississippisportsapp.com/*", "zone_name": "mississippisportsapp.com" }
  ]
}
