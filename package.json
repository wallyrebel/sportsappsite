{
  "name": "ms-sports-app-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scoreboard/scripts/copy-assets.mjs && astro build",
    "test:scoreboard": "node --test scoreboard/test/*.test.mjs && node --import tsx --test tests/scoreboard-integration.test.ts",
    "collect:scoreboard": "node scoreboard/scripts/collect.mjs",
    "deploy:scoreboard": "wrangler deploy --config scoreboard/wrangler.jsonc",
    "preview": "astro preview",
    "astro": "astro",
    "test:broadcast": "node --import tsx --test tests/broadcast.test.ts",
    "verify:broadcast": "node --import tsx scripts/broadcast-verify.ts",
    "types:broadcast": "wrangler types workers/broadcast/worker-configuration.d.ts --config workers/broadcast/wrangler.jsonc",
    "check:broadcast": "tsc -p workers/broadcast/tsconfig.json",
    "deploy:broadcast": "wrangler deploy --config workers/broadcast/wrangler.jsonc",
    "test:watch-scoreboard": "node --test tests/watch-scoreboard.test.mjs",
    "deploy:watch-scoreboard": "wrangler deploy --config workers/watch-scoreboard/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.2.0",
    "acorn": "^8.18.0",
    "astro": "^5.17.1",
    "cheerio": "^1.2.0",
    "devalue": "^6.0.2",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.143.0"
  }
}
